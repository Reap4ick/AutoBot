# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=replace_with_telegram_api_hash
TG_SESSION_NAME=telegram_userbot

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated Telegram chat IDs. Keep non-empty for safer operation.
# Example: ALLOWED_CHAT_IDS=123456789,-1001234567890
ALLOWED_CHAT_IDS=
ALLOW_GROUPS=false

REPLY_DELAY_SECONDS=2
COOLDOWN_SECONDS=15
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=2000
LOG_LEVEL=INFO

SYSTEM_PROMPT=Ти відповідаєш природно, коротко і по суті мовою співрозмовника. Відповідай лише на останнє повідомлення. Не вигадуй фактів. Не додавай службових пояснень, внутрішніх міркувань, лапок або markdown. Якщо запит потребує рішення власника, скажи, що він відповість пізніше.
