# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=replace_with_telegram_api_hash
TG_SESSION_NAME=telegram_userbot

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated Telegram chat IDs. Keep non-empty for safer operation.
# Example: ALLOWED_CHAT_IDS=123456789,-1001234567890
ALLOWED_CHAT_IDS=
ALLOW_GROUPS=false

REPLY_DELAY_SECONDS=2
COOLDOWN_SECONDS=15
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=2000
LOG_LEVEL=INFO

SYSTEM_PROMPT=Ти відповідаєш природно, коротко і по суті українською мовою. Не вигадуй фактів. Якщо запит потребує рішення власника, скажи, що він відповість пізніше.
