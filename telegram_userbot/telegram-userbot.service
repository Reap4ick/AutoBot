[Unit]
Description=Telegram userbot with Groq replies
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/AutoBot/telegram_userbot
EnvironmentFile=/opt/AutoBot/telegram_userbot/.env
ExecStart=/opt/AutoBot/telegram_userbot/.venv/bin/python /opt/AutoBot/telegram_userbot/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
